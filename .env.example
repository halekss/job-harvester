# La Bonne Alternance (api.apprentissage.beta.gouv.fr) — Authorization: Bearer <token>
LBA_API_KEY=

# France Travail (api.francetravail.io) — OAuth2 client_credentials
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# SQLite database file used by the api and harvester
DB_PATH=./job-harvester.sqlite

# YAML file describing harvest campaigns
CAMPAIGNS_FILE=./config/campaigns.yaml

# Local REST API port
PORT=3000

# Active le scheduler cron intégré au serveur API (déclenche automatiquement les collectes
# selon le champ `schedule` de chaque campagne dans config/campaigns.yaml). Laisser vide en
# dev local pour ne pas déclencher de collectes réelles vers des API externes à chaque
# redémarrage du serveur.
ENABLE_SCHEDULER=

# Linear (api.linear.app/graphql) — used for connector incident reporting (JOB-8)
LINEAR_API_KEY=
LINEAR_TEAM_ID=

# Welcome to the Jungle (csekhvms53-dsn.algolia.net) — clé Algolia search-only publique utilisée
# par le site pour sa propre recherche d'offres. Optionnelles : sans elles, le connecteur
# `welcometothejungle` reste inactif (pas d'erreur) plutôt que d'échouer à chaque campagne.
# Si la découverte automatique documentée dans docs/sources.md ne fonctionne plus (rotation de
# clé côté WTTJ), capturez-les manuellement depuis les devtools réseau d'un navigateur réel sur
# welcometothejungle.com (onglet Réseau, filtrer "algolia.net", en-têtes de requête
# x-algolia-application-id / x-algolia-api-key).
WTTJ_ALGOLIA_APP_ID=
WTTJ_ALGOLIA_API_KEY=
